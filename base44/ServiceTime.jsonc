{
  "name": "ServiceTime",
  "type": "object",
  "properties": {
    "label": {
      "type": "string"
    },
    "day_of_week": {
      "type": "string",
      "enum": [
        "Sunday",
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday"
      ]
    },
    "time": {
      "type": "string",
      "description": "24 hour time, HH:mm"
    },
    "end_time": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "label",
    "day_of_week",
    "time"
  ]
}