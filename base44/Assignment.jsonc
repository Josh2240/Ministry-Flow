{
  "name": "Assignment",
  "type": "object",
  "properties": {
    "service_id": {
      "type": "string"
    },
    "service_title": {
      "type": "string"
    },
    "service_date": {
      "type": "string",
      "description": "Date in YYYY-MM-DD format"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "member_id": {
      "type": "string"
    },
    "member_name": {
      "type": "string"
    },
    "team": {
      "type": "string",
      "enum": [
        "worship_leader",
        "vocals",
        "band",
        "media",
        "sound",
        "lighting",
        "other"
      ],
      "default": "band"
    },
    "position": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "declined"
      ],
      "default": "pending"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "service_id",
    "member_id"
  ]
}