{
  "name": "Availability",
  "type": "object",
  "properties": {
    "member_id": {
      "type": "string"
    },
    "member_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "description": "Date in YYYY-MM-DD format"
    },
    "availability": {
      "type": "string",
      "enum": [
        "available",
        "unavailable"
      ],
      "default": "available"
    },
    "from_time": {
      "type": "string"
    },
    "to_time": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "member_id",
    "date"
  ]
}