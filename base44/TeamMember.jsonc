{
  "name": "TeamMember",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "worship_leader",
        "vocalist",
        "musician",
        "media",
        "sound",
        "lighting",
        "other"
      ],
      "default": "musician"
    },
    "instrument": {
      "type": "string"
    },
    "voice_part": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "full_name"
  ]
}